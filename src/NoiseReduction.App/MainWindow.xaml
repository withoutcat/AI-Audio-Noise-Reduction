<Window x:Class="NoiseReduction.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AI Noise Reduction"
        Width="400"
        Height="440"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        BorderBrush="#F8A0C8"
        BorderThickness="1"
        FontFamily="Microsoft YaHei, Segoe UI, sans-serif"
        MouseLeftButtonDown="OnDragMove">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/logo.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="𝔸𝕀 ℕ𝕠𝕚𝕤𝕖 𝕊𝕦𝕡𝕡𝕣𝕖𝕤𝕤𝕚𝕠𝕟"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#E84393"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Window control buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="{Binding TopMostIcon}"
                        Width="24" Height="24" Padding="0"
                        FontSize="14"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="{Binding TopMostTooltip}"
                        Click="OnTopMostClick" />
                <Button Content="❐"
                        Width="24" Height="24" Padding="0"
                        FontSize="16"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="切换小窗口模式"
                        Click="OnMiniBarClick" />
                <Button Content="➖"
                        Width="24" Height="24" Padding="0"
                        FontSize="10"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="最小化到托盘"
                        Click="OnMinimizeToTrayClick" />
            </StackPanel>
        </Grid>

        <!-- Device Selection -->
        <Grid Grid.Row="1"
              Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1. 需降噪设备 -->
            <StackPanel Grid.Row="0"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="需降噪设备"
                           FontSize="14"
                           VerticalAlignment="Center"
                           ToolTip="选择需要进行AI降噪处理的麦克风设备，降噪后的音频将从CABLE Output输出" />
            </StackPanel>
            <ComboBox Grid.Row="0"
                      Grid.Column="1"
                      MinHeight="34"
                      FontSize="14"
                      ItemsSource="{Binding CaptureDevices}"
                      SelectedItem="{Binding SelectedCaptureDevice}"
                      DisplayMemberPath="Name" />

            <!-- 2. 降噪模式 -->
            <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,14,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="降噪模式"
                           FontSize="14"
                           VerticalAlignment="Center" />
            </StackPanel>
            <ComboBox Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,14,0,0"
                      MinHeight="34"
                      FontSize="14"
                      SelectedValue="{Binding AinsMode}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="均衡 - 适合日常使用" Tag="0" ToolTip="适合日常使用，平衡降噪效果和音质" />
                <ComboBoxItem Content="强力 - 适合嘈杂环境" Tag="1" ToolTip="适合嘈杂环境，最大限度消除背景噪音" />
                <ComboBoxItem Content="超低延迟 - 适合实时合唱" Tag="2" ToolTip="适合实时合唱等对延迟敏感的场景" />
            </ComboBox>
        </Grid>

        <!-- Default Device Warning -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="8,6"
                Background="#FFF8E1"
                BorderBrush="#F0C040"
                BorderThickness="1"
                CornerRadius="3">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowDeviceWarning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           FontSize="12"
                           Foreground="#8D6E00"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding DeviceWarningText}" />
                <Button Grid.Column="1"
                        Content="去设置"
                        MinWidth="56"
                        MinHeight="24"
                        Padding="8,0"
                        Margin="8,0,0,0"
                        FontSize="12"
                        Cursor="Hand"
                        Click="OnOpenSoundSettings" />
            </Grid>
        </Border>

        <!-- Log Panel -->
        <Grid Grid.Row="3"
              Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                       LastChildFill="False"
                       Margin="0,0,0,6">
                <CheckBox DockPanel.Dock="Right"
                          Content="调试"
                          IsChecked="{Binding DebugMode}"
                          Margin="0,0,4,0"
                          VerticalAlignment="Center"
                          FontSize="12" 
                          ToolTip="调试模式会显示更详细的日志信息" />
                <Button DockPanel.Dock="Right"
                        ToolTip="清除日志"
                        Width="24"
                        Height="24"
                        Padding="0"
                        Margin="0,0,1,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding ClearLogCommand}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="🗑" FontSize="14" Foreground="#6A737D" />
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </DockPanel>

            <RichTextBox Grid.Row="1"
                         x:Name="LogRichTextBox"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Background="{StaticResource SurfaceBrush}"
                         BorderThickness="0"
                         Padding="0"
                         FontFamily="Consolas, Courier New, monospace"
                         FontSize="12">
                <RichTextBox.Document>
                    <FlowDocument PagePadding="0" />
                </RichTextBox.Document>
            </RichTextBox>
        </Grid>

        <!-- Status Bar -->
        <DockPanel Grid.Row="4"
                   LastChildFill="False"
                   Margin="0,10,0,0">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="#5A6472"
                               FontSize="12"
                               Text="{Binding RunStateText}" />
                    <TextBlock Foreground="#B0B8C4"
                               FontSize="11"
                               Text="{Binding VersionText}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Margin="0,2,0,0"
                           Foreground="#5A6472"
                           FontSize="12"
                           Text="{Binding ResourceText}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Foreground="#1F7A8C"
                           FontSize="12"
                           TextDecorations="Underline"
                           Cursor="Hand"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           MouseDown="OnAppIdClick"
                           Text="{Binding ConnectivityText}" />
                <Button Style="{StaticResource StartStopButtonStyle}"
                        ToolTip="{Binding StartButtonTooltip}"
                        Command="{Binding ToggleCommand}"
                        Content="{Binding ToggleButtonText}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
